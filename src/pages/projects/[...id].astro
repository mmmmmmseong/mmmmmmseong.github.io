---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Connections from '../../components/Connections.astro';
import SubDocs from '../../components/SubDocs.astro';
import DocPager from '../../components/DocPager.astro';
import ProjectNav from '../../components/ProjectNav.astro';
import {
  childrenOf,
  connections,
  getAllProjects,
  getTagInfo,
  getWiki,
  parentOf,
  prepareSubDocs,
  siblingsOf,
  subDocToc,
  urlOf,
  type Project,
} from '../../lib/content';

export async function getStaticPaths() {
  // 하위 문서(예: mode/mode-v0-6)도 각자 페이지를 가진다.
  const projects = await getAllProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const { Content, headings } = await render(project);
const { title, summary, period, role, stack, tags, github, demo, thumbnail } = project.data;
const all = await getAllProjects();
const related = connections(project, [...(await getWiki()), ...all]);
const tagInfo = await getTagInfo();

const subs = prepareSubDocs(childrenOf(project, all)); // 상위 프로젝트라면: 하위 문서
const parent = parentOf(project, all); // 하위 문서라면: 상위 프로젝트와 이전·다음 문서
const { prev, next } = siblingsOf(project, all);
const hasFacts = Boolean(period || role || stack.length);

// 하위 문서가 있는 프로젝트는 위키처럼 왼쪽에 문서 목록을 둔다 (상위·하위 문서 모두).
const root = parent ?? project;
const family = childrenOf(root, all);
const hasNav = family.length > 0;
const current = urlOf(project);
const toc = [...headings.filter((h) => h.depth >= 2 && h.depth <= 3), ...subDocToc(subs)];
const hasToc = toc.length > 1;
---

<Base title={title} description={summary}>
  <div class:list={['layout', { 'has-nav': hasNav, 'has-toc': hasToc }]}>
  {hasNav && <aside class="side"><ProjectNav root={root} docs={family} current={current} variant="sidebar" /></aside>}
  <article>
    {hasNav && <div class="mobile-only"><ProjectNav root={root} docs={family} current={current} variant="mobile" /></div>}
    {
      parent ? (
        <a class="back parent-link" href={urlOf(parent)}>
          ↑ {parent.data.title}
        </a>
      ) : (
        <a class:list={['back', { 'no-nav-only': hasNav }]} href="/projects">
          ← 프로젝트
        </a>
      )
    }
    <header>
      <h1>{title}</h1>
      {summary && <p class="summary">{summary}</p>}
      {subs.length > 0 && <p class="sub-count">하위 문서 {subs.length}개 · <a href="#subdocs">아래에서 보기</a></p>}
      {hasFacts && (
      <dl class="facts">
        {
          period && (
            <div>
              <dt>기간</dt>
              <dd>{period}</dd>
            </div>
          )
        }
        {
          role && (
            <div>
              <dt>역할</dt>
              <dd>{role}</dd>
            </div>
          )
        }
        {
          stack.length > 0 && (
            <div>
              <dt>기술</dt>
              <dd>
                <ul class="tags">
                  {stack.map((s) => (
                    <li class="tag">{s}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
      </dl>
      )}
      {
        (github || demo) && (
          <div class="links">
            {github && (
              <a class="btn ghost" href={github}>
                GitHub
              </a>
            )}
            {demo && (
              <a class="btn" href={demo}>
                데모 보기
              </a>
            )}
          </div>
        )
      }
    </header>

    {thumbnail && <img class="cover" src={thumbnail} alt="" />}

    <div class="prose">
      <Content />
    </div>

    <div id="subdocs"><SubDocs subs={subs} /></div>
    <DocPager prev={prev} next={next} />

    {
      tags.length > 0 && (
        <ul class="tags footer-tags">
          {tags.map(tagInfo).map((t) => (
            <li>
              <a class="tag" href={`/tags/${t.id}`}>
                #{t.name}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <Connections items={related} />
  </article>

  {
    hasToc && (
      <nav class="toc" aria-label="목차">
        <p>목차</p>
        <ul>
          {toc.map((h) => (
            <li class={`d${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
  </div>
</Base>

<style>
  /* 기본: 본문 한 단(780px). 하위 문서가 있으면 왼쪽 문서 목록, 목차가 있으면 오른쪽 목차를 붙인다. */
  .layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; align-items: start; max-width: 780px; margin: 0 auto; }
  .layout.has-toc { grid-template-columns: minmax(0, 1fr) 200px; max-width: 1020px; }
  .layout.has-nav { grid-template-columns: 220px minmax(0, 1fr); max-width: none; }
  .layout.has-nav.has-toc { grid-template-columns: 220px minmax(0, 1fr) 200px; }
  article { min-width: 0; }
  .side, .toc { position: sticky; top: 84px; max-height: calc(100vh - 110px); overflow-y: auto; }
  .mobile-only { display: none; }
  /* 넓은 화면에서는 사이드바에 "← 프로젝트"가 있으므로 본문 위 링크를 숨긴다 */
  .has-nav .no-nav-only { display: none; }

  .toc p { margin: 0 0 8px; color: var(--muted); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.04em; }
  .toc ul { margin: 0; padding: 0 0 0 12px; list-style: none; border-left: 1px solid var(--border); font-size: 0.86rem; }
  .toc li { padding: 3px 0; }
  .toc .d3 { padding-left: 12px; }
  .toc a { color: var(--muted); }
  .toc a:hover { color: var(--accent); text-decoration: none; }

  @media (max-width: 1100px) {
    .toc { display: none; }
    .layout.has-toc { grid-template-columns: minmax(0, 1fr); max-width: 780px; }
    .layout.has-nav, .layout.has-nav.has-toc { grid-template-columns: 220px minmax(0, 1fr); max-width: none; }
  }
  @media (max-width: 820px) {
    .layout.has-nav, .layout.has-nav.has-toc { grid-template-columns: minmax(0, 1fr); }
    .side { display: none; }
    .mobile-only { display: block; }
    .has-nav .no-nav-only { display: none; }
  }
  .back { color: var(--muted); font-size: 0.9rem; }
  .parent-link { color: var(--accent); font-weight: 600; }
  .sub-count { margin: 10px 0 0; color: var(--muted); font-size: 0.88rem; }
  header { margin: 16px 0 32px; }
  h1 { margin: 0 0 8px; font-size: clamp(1.7rem, 4vw, 2.2rem); letter-spacing: -0.02em; }
  .summary { margin: 0; color: var(--muted); font-size: 1.08rem; }
  .facts {
    display: grid;
    gap: 10px;
    margin: 24px 0 0;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .facts div { display: grid; grid-template-columns: 56px 1fr; gap: 12px; align-items: baseline; }
  dt { color: var(--muted); font-size: 0.88rem; }
  dd { margin: 0; }
  .links { display: flex; gap: 10px; margin-top: 20px; }
  .cover { display: block; width: 100%; margin-bottom: 32px; border-radius: var(--radius); border: 1px solid var(--border); }
  .footer-tags { margin-top: 40px; }
</style>
