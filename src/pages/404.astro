---
import Base from '../layouts/Base.astro';
---

<Base title="페이지를 찾을 수 없음">
  <div class="nf">
    <p class="code">404</p>
    <h1>페이지를 찾을 수 없다</h1>
    <p class="muted">주소가 바뀌었거나 아직 작성되지 않은 문서일 수 있다.</p>
    <a class="btn" href="/">홈으로</a>
  </div>
</Base>

<style>
  .nf { padding: 60px 0; text-align: center; }
  .code { margin: 0; color: var(--accent); font-size: 3rem; font-weight: 800; }
  h1 { margin: 0 0 8px; font-size: 1.4rem; }
  .btn { margin-top: 20px; }
</style>
