---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WikiTree from '../../components/WikiTree.astro';
import Connections from '../../components/Connections.astro';
import { buildTree, connections, formatDate, getProjects, getTagInfo, getWiki, urlOf, wikiCategory, type Wiki } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getWiki();
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Wiki };
const { Content, headings } = await render(entry);
const all = await getWiki();
const tree = buildTree(all);
const related = connections(entry, [...(await getProjects()), ...all]);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const { title, description, tags, created, updated } = entry.data;
const category = wikiCategory(entry);
const tagInfo = await getTagInfo();
---

<Base title={title} description={description}>
  <div class="layout">
    <aside class="sidebar">
      <a class="all" href="/wiki">← 위키 전체</a>
      <WikiTree node={tree} current={urlOf(entry)} />
    </aside>

    <article>
      <header>
        {category && <p class="crumb">{category.split('/').join(' / ')}</p>}
        <h1>{title}</h1>
        {description && <p class="desc">{description}</p>}
        <div class="meta">
          {created && <span>작성 {formatDate(created)}</span>}
          {updated && <span>수정 {formatDate(updated)}</span>}
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      {
        tags.length > 0 && (
          <ul class="tags footer-tags">
            {tags.map(tagInfo).map((t) => (
              <li>
                <a class="tag" href={`/tags/${t.id}`}>
                  #{t.name}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <Connections items={related} />
    </article>

    {
      toc.length > 1 && (
        <nav class="toc" aria-label="목차">
          <p>목차</p>
          <ul>
            {toc.map((h) => (
              <li class={`d${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</Base>

<style>
  .layout { display: grid; grid-template-columns: 240px minmax(0, 1fr) 200px; gap: 40px; align-items: start; }
  .sidebar, .toc { position: sticky; top: 84px; max-height: calc(100vh - 110px); overflow-y: auto; }
  .all { display: block; margin-bottom: 12px; color: var(--muted); font-size: 0.9rem; }
  article { min-width: 0; }
  header { margin-bottom: 32px; padding-bottom: 20px; border-bottom: 1px solid var(--border); }
  .crumb { margin: 0 0 6px; color: var(--accent); font-size: 0.88rem; font-weight: 600; }
  h1 { margin: 0; font-size: clamp(1.7rem, 4vw, 2.2rem); letter-spacing: -0.02em; }
  .desc { margin: 8px 0 0; color: var(--muted); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; margin-top: 14px; color: var(--muted); font-size: 0.86rem; }
  .footer-tags { margin-top: 40px; }

  .toc p { margin: 0 0 8px; color: var(--muted); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.04em; }
  .toc ul { margin: 0; padding: 0 0 0 12px; list-style: none; border-left: 1px solid var(--border); font-size: 0.86rem; }
  .toc li { padding: 3px 0; }
  .toc .d3 { padding-left: 12px; }
  .toc a { color: var(--muted); }
  .toc a:hover { color: var(--accent); text-decoration: none; }

  @media (max-width: 1100px) {
    .layout { grid-template-columns: 220px minmax(0, 1fr); }
    .toc { display: none; }
  }
  @media (max-width: 820px) {
    .layout { grid-template-columns: 1fr; }
    .sidebar { position: static; max-height: none; order: 2; padding-top: 24px; border-top: 1px solid var(--border); }
  }
</style>
