---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WikiTree from '../../components/WikiTree.astro';
import Connections from '../../components/Connections.astro';
import {
  buildTree,
  connections,
  formatDate,
  getProjects,
  getTagInfo,
  getWiki,
  urlOf,
  wikiCategory,
  wikiChildren,
  wikiParent,
  type Wiki,
} from '../../lib/content';
import { noteKey } from '../../lib/vault';

export async function getStaticPaths() {
  const entries = await getWiki();
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Wiki };
const { Content, headings } = await render(entry);
const all = await getWiki();
const tree = buildTree(all);
const related = connections(entry, [...(await getProjects()), ...all]);
const { title, description, tags, created, updated } = entry.data;
const category = wikiCategory(entry);
const tagInfo = await getTagInfo();

// 상위 문서라면: 하위 문서 내용을 이 페이지에서 펼쳐 볼 수 있게 준비한다.
// 여러 문서를 한 페이지에 넣으면 같은 제목 주소(#설치 등)가 겹치므로, 하위 문서마다 앞에 구분자를 붙인다.
const children = wikiChildren(entry, all).map((child) => {
  const prefix = noteKey(child.id);
  const html = (child.rendered?.html ?? '')
    .replace(/\sid="([^"]+)"/g, ` id="${prefix}--$1"`)
    .replace(/href="#([^"]+)"/g, `href="#${prefix}--$1"`);
  const childHeadings = (child.rendered?.metadata?.headings ?? []) as { depth: number; slug: string; text: string }[];
  return { child, prefix, html, headings: childHeadings.filter((h) => h.depth === 2) };
});

// 하위 문서라면: 상위 문서와 이전/다음 문서
const parent = wikiParent(entry, all);
const siblings = parent ? wikiChildren(parent, all) : [];
const index = siblings.findIndex((e) => e.id === entry.id);
const prev = index > 0 ? siblings[index - 1] : undefined;
const next = index !== -1 && index < siblings.length - 1 ? siblings[index + 1] : undefined;

const toc = [
  ...headings.filter((h) => h.depth >= 2 && h.depth <= 3),
  ...children.flatMap(({ child, prefix, headings: hs }) => [
    { depth: 2, slug: prefix, text: child.data.title },
    ...hs.map((h) => ({ depth: 3, slug: `${prefix}--${h.slug}`, text: h.text })),
  ]),
];
---

<Base title={title} description={description}>
  <div class="layout">
    <aside class="sidebar">
      <a class="all" href="/wiki">← 위키 전체</a>
      <WikiTree node={tree} current={urlOf(entry)} />
    </aside>

    <article>
      <header>
        {
          parent ? (
            <a class="crumb parent-link" href={urlOf(parent)}>
              ↑ {parent.data.title}
            </a>
          ) : (
            category && <p class="crumb">{category.split('/').join(' / ')}</p>
          )
        }
        <h1>{title}</h1>
        {description && <p class="desc">{description}</p>}
        <div class="meta">
          {created && <span>작성 {formatDate(created)}</span>}
          {updated && <span>수정 {formatDate(updated)}</span>}
          {children.length > 0 && <span>하위 문서 {children.length}개</span>}
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      {
        children.length > 0 && (
          <section class="subdocs" aria-label="하위 문서">
            <div class="subdocs-head">
              <h2>하위 문서</h2>
              <button type="button" class="toggle-all" aria-pressed="false">
                모두 펼치기
              </button>
            </div>
            {children.map(({ child, prefix, html }) => (
              <details class="subdoc" id={prefix}>
                <summary>
                  <span class="sub-title">{child.data.title}</span>
                  {child.data.description && <span class="sub-desc">{child.data.description}</span>}
                </summary>
                <div class="sub-body">
                  <a class="sub-link" href={urlOf(child)}>
                    이 문서만 따로 보기 →
                  </a>
                  <div class="prose" set:html={html} />
                </div>
              </details>
            ))}
          </section>
        )
      }

      {
        (prev || next) && (
          <nav class="pager" aria-label="같은 상위 문서의 이전·다음 문서">
            {prev ? (
              <a class="prev" href={urlOf(prev)}>
                <span>← 이전</span>
                {prev.data.title}
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a class="next" href={urlOf(next)}>
                <span>다음 →</span>
                {next.data.title}
              </a>
            )}
          </nav>
        )
      }

      {
        tags.length > 0 && (
          <ul class="tags footer-tags">
            {tags.map(tagInfo).map((t) => (
              <li>
                <a class="tag" href={`/tags/${t.id}`}>
                  #{t.name}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <Connections items={related} />
    </article>

    {
      toc.length > 1 && (
        <nav class="toc" aria-label="목차">
          <p>목차</p>
          <ul>
            {toc.map((h) => (
              <li class={`d${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</Base>

<script>
  const subdocs = [...document.querySelectorAll<HTMLDetailsElement>('details.subdoc')];
  const toggle = document.querySelector<HTMLButtonElement>('.toggle-all');

  const sync = () => {
    if (!toggle) return;
    const allOpen = subdocs.every((d) => d.open);
    toggle.textContent = allOpen ? '모두 접기' : '모두 펼치기';
    toggle.setAttribute('aria-pressed', String(allOpen));
  };

  toggle?.addEventListener('click', () => {
    const open = !subdocs.every((d) => d.open);
    subdocs.forEach((d) => (d.open = open));
  });
  subdocs.forEach((d) => d.addEventListener('toggle', sync));

  // 목차나 주소(#...)로 접힌 하위 문서 안의 제목을 가리키면 펼친 뒤 그 위치로 이동한다.
  const reveal = () => {
    if (!location.hash) return;
    const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    const box = target?.closest('details.subdoc') as HTMLDetailsElement | null;
    if (target && box && !box.open) {
      box.open = true;
      target.scrollIntoView();
    }
  };
  window.addEventListener('hashchange', reveal);
  reveal();
</script>

<style>
  .layout { display: grid; grid-template-columns: 240px minmax(0, 1fr) 200px; gap: 40px; align-items: start; }
  .sidebar, .toc { position: sticky; top: 84px; max-height: calc(100vh - 110px); overflow-y: auto; }
  .all { display: block; margin-bottom: 12px; color: var(--muted); font-size: 0.9rem; }
  article { min-width: 0; }
  header { margin-bottom: 32px; padding-bottom: 20px; border-bottom: 1px solid var(--border); }
  .crumb { display: inline-block; margin: 0 0 6px; color: var(--accent); font-size: 0.88rem; font-weight: 600; }
  h1 { margin: 0; font-size: clamp(1.7rem, 4vw, 2.2rem); letter-spacing: -0.02em; }
  .desc { margin: 8px 0 0; color: var(--muted); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; margin-top: 14px; color: var(--muted); font-size: 0.86rem; }
  .footer-tags { margin-top: 40px; }

  /* 하위 문서 */
  .subdocs { margin-top: 48px; }
  .subdocs-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
  .subdocs-head h2 { margin: 0; font-size: 1.3rem; }
  .toggle-all {
    padding: 5px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--muted);
    font: inherit;
    font-size: 0.86rem;
    cursor: pointer;
  }
  .toggle-all:hover { color: var(--accent); border-color: var(--accent); }
  .subdoc {
    margin-bottom: 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    scroll-margin-top: 80px;
  }
  .subdoc > summary {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 18px 14px 40px;
    position: relative;
    cursor: pointer;
    list-style: none;
  }
  .subdoc > summary::-webkit-details-marker { display: none; }
  .subdoc > summary::before {
    content: '▸';
    position: absolute;
    left: 18px;
    top: 15px;
    color: var(--muted);
    transition: transform 0.15s ease;
  }
  .subdoc[open] > summary::before { transform: rotate(90deg); }
  .subdoc > summary:hover .sub-title { color: var(--accent); }
  .sub-title { font-weight: 700; font-size: 1.05rem; }
  .sub-desc { color: var(--muted); font-size: 0.9rem; }
  .sub-body { padding: 4px 22px 22px; border-top: 1px solid var(--border); }
  .sub-link { display: inline-block; margin: 14px 0 6px; font-size: 0.88rem; }

  /* 이전·다음 */
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 48px; }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font-weight: 600;
  }
  .pager a span { color: var(--muted); font-size: 0.8rem; font-weight: 400; }
  .pager a:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }
  .pager .next { grid-column: 2; text-align: right; }

  .toc p { margin: 0 0 8px; color: var(--muted); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.04em; }
  .toc ul { margin: 0; padding: 0 0 0 12px; list-style: none; border-left: 1px solid var(--border); font-size: 0.86rem; }
  .toc li { padding: 3px 0; }
  .toc .d3 { padding-left: 12px; }
  .toc a { color: var(--muted); }
  .toc a:hover { color: var(--accent); text-decoration: none; }

  @media (max-width: 1100px) {
    .layout { grid-template-columns: 220px minmax(0, 1fr); }
    .toc { display: none; }
  }
  @media (max-width: 820px) {
    .layout { grid-template-columns: 1fr; }
    .sidebar { position: static; max-height: none; order: 2; padding-top: 24px; border-top: 1px solid var(--border); }
    .sub-body { padding: 4px 14px 16px; }
  }
</style>
