---
import Base from '../../layouts/Base.astro';
import WikiList from '../../components/WikiList.astro';
import WikiTree from '../../components/WikiTree.astro';
import { buildTree, getWiki } from '../../lib/content';

const entries = await getWiki();
const tree = buildTree(entries);
---

<Base title="위키" description="공부하고 정리한 내용을 모아둔 개인 위키">
  <h1>위키</h1>
  <p class="muted">공부하고 정리한 내용을 주제별로 모아둡니다. 문서 {entries.length}개</p>

  {
    entries.length ? (
      <div class="layout">
        <aside>
          <h2>분류</h2>
          <WikiTree node={tree} />
        </aside>
        <section>
          <h2>최근 업데이트</h2>
          <WikiList entries={entries.slice(0, 20)} />
        </section>
      </div>
    ) : (
      <p class="empty">아직 위키 문서가 없습니다. content/wiki 폴더에 글을 추가해 보세요.</p>
    )
  }
</Base>

<style>
  h1 { margin: 0 0 4px; }
  .layout { display: grid; grid-template-columns: 260px 1fr; gap: 40px; margin-top: 36px; }
  h2 { margin: 0 0 12px; color: var(--muted); font-size: 0.85rem; font-weight: 700; letter-spacing: 0.04em; }
  @media (max-width: 820px) {
    .layout { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
