---
import Base from '../../layouts/Base.astro';
import { getTagInfo, getTagMap } from '../../lib/content';

const tags = await getTagMap();
const tagInfo = await getTagInfo();
---

<Base title="태그" description="위키와 프로젝트의 태그 모음">
  <h1>태그</h1>
  <p class="muted">위키와 프로젝트를 태그로 모아봅니다.</p>
  {
    tags.size ? (
      <ul class="tags cloud">
        {[...tags].map(([tag, items]) => (
          <li>
            <a class="tag" href={`/tags/${tag}`} title={tagInfo(tag).description}>
              #{tagInfo(tag).name} <span>{items.length}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">아직 태그가 없습니다.</p>
    )
  }
</Base>

<style>
  h1 { margin: 0 0 4px; }
  .cloud { gap: 10px; margin-top: 32px; }
  .cloud .tag { padding: 4px 14px; font-size: 0.95rem; }
  .cloud span { margin-left: 2px; opacity: 0.65; font-size: 0.82em; }
</style>
