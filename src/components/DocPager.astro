---
// 같은 상위 문서 아래의 이전·다음 문서 링크 (위키·프로젝트 공통)
import type { Note } from '../lib/content';
import { urlOf } from '../lib/content';

interface Props {
  prev?: Note;
  next?: Note;
}

const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav class="pager" aria-label="같은 상위 문서의 이전·다음 문서">
      {prev ? (
        <a class="prev" href={urlOf(prev)}>
          <span>← 이전</span>
          {prev.data.title}
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a class="next" href={urlOf(next)}>
          <span>다음 →</span>
          {next.data.title}
        </a>
      )}
    </nav>
  )
}

<style>
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 48px; }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font-weight: 600;
  }
  .pager a span { color: var(--muted); font-size: 0.8rem; font-weight: 400; }
  .pager a:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }
  .pager .next { grid-column: 2; text-align: right; }
</style>
