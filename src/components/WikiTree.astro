---
import type { TreeNode } from '../lib/content';
import { countEntries, urlOf } from '../lib/content';

interface Props {
  node: TreeNode;
  current?: string; // 현재 보고 있는 문서 URL
  depth?: number; // 트리 깊이 (최상위 분류 = 0)
}

const { node, current, depth = 0 } = Astro.props;
// 위키 첫 화면: 최상위 분류만 펼친다. 문서 페이지: 지금 문서가 들어 있는 폴더만 펼친다.
const isOpen = (path: string) =>
  current ? current === `/wiki/${path}` || current.startsWith(`/wiki/${path}/`) : depth === 0;
---

<ul class="tree">
  {
    node.children.map((child) => (
      <li>
        <details open={isOpen(child.path) || undefined}>
          <summary>
            {child.page ? (
              <a class="page" href={urlOf(child.page)} aria-current={urlOf(child.page) === current ? 'page' : undefined}>
                {child.page.data.title}
              </a>
            ) : (
              child.name
            )}
            <span class="count">{countEntries(child)}</span>
          </summary>
          <Astro.self node={child} current={current} depth={depth + 1} />
        </details>
      </li>
    ))
  }
  {
    node.entries.map((e) => (
      <li>
        <a href={urlOf(e)} aria-current={urlOf(e) === current ? 'page' : undefined}>
          {e.data.title}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tree { margin: 0; padding: 0; list-style: none; font-size: 0.93rem; }
  .tree .tree { margin-left: 10px; padding-left: 10px; border-left: 1px solid var(--border); }
  summary {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 6px;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary::before {
    content: '▸';
    color: var(--muted);
    font-size: 0.8em;
    transition: transform 0.15s ease;
  }
  details[open] > summary::before { transform: rotate(90deg); }
  summary:hover { background: var(--surface-2); }
  .count { margin-left: auto; color: var(--muted); font-size: 0.78rem; font-weight: 400; }
  a {
    display: block;
    padding: 4px 6px;
    border-radius: 6px;
    color: var(--muted);
  }
  a:hover { color: var(--text); background: var(--surface-2); text-decoration: none; }
  a[aria-current='page'] { color: var(--accent); background: var(--accent-soft); font-weight: 600; }
  /* 상위 문서가 있는 폴더: 이름을 누르면 상위 문서로, 화살표를 누르면 접기/펼치기 */
  summary a.page { flex: 1; min-width: 0; margin: -4px 0; padding: 4px 6px; color: var(--text); font-weight: 600; }
  summary a.page:hover { color: var(--accent); background: none; }
  summary a.page[aria-current='page'] { color: var(--accent); background: var(--accent-soft); }
</style>
